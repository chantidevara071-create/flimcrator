# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

# Required: random secret used to sign session cookies (keep this private)
SECRET_KEY=change-me-to-a-long-random-string

# Optional: OpenAI API key for the AI Story Assistant
# Get one at https://platform.openai.com/api-keys
# Without this key, the AI page shows a friendly "not configured" message.
OPENAI_API_KEY=

# Optional: model name for OpenAI (default used if blank)
OPENAI_MODEL=gpt-4o-mini

# Optional: create the first admin account on startup (only if no admin exists yet)
# Leave blank if you do not want an admin created automatically.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
